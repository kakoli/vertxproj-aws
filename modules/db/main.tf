locals {
  name = "${var.project_name}-${var.environment}"

  # Content of a shell file uploaded at /tmp/dbscripts/db.env by "file" provisioner. db.env file is run by run_schema.sh
  # Uploaded into a 700 folder at L:122 and deleted by the script when it finishes.
  # Credentials for the runner on EC2. Passwords are alphanumeric, so quoting is safe.
  db_env = <<-EOT
    export PGHOST='${aws_db_instance.postgres.address}' # address is a computed attribute: AWS provides it after the instance is created,
    export PGPORT='${aws_db_instance.postgres.port}'
    export DB_NAME='${var.db_name}'
    export ADMIN_USER='${var.admin_user}'
    export ADMIN_PASSWORD='${random_password.admin.result}'
    export APP_USER='${var.app_user}'
    export APP_PASSWORD='${random_password.app.result}'
    export ENTRY_SCRIPT='${var.entry_script}'
    export SCHEMA_MODE='${var.schema_mode}'
  EOT
  # Calculates SHA-256 checksums to track changes on the sql and runner script files. Files themselves are uploaded as plain text.
  # This hash happens on local where Terraform is run. A second hash happens on EC2 (run_schema.sh L:54)
  sql_files    = sort([for p in fileset(var.scripts_dir, "**") : p if endswith(p, ".sql")])
  scripts_hash = sha256(join(",", [for f in sort(fileset(var.scripts_dir, "*.sql")) : filesha256("${var.scripts_dir}/${f}")]))
  runner_hash  = sha256("${file("${path.module}/scripts/bootstrap.sql")}${file("${path.module}/scripts/run_schema.sh")}")
}

############################ Passwords ############################
# Generated by Terraform and kept in state (sensitive). Read them with:
#   terraform output -raw db_admin_password / db_app_password
resource "random_password" "admin" {
  length  = 24
  special = false
}

resource "random_password" "app" {
  length  = 24
  special = false
}

############################ RDS ############################
resource "aws_db_subnet_group" "main" {
  name       = "${local.name}-db"
  subnet_ids = var.private_subnet_ids

  tags = { Name = "${local.name}-db-subnets" }
}

resource "aws_db_instance" "postgres" {
  identifier = "${local.name}-db"

  engine         = "postgres"
  engine_version = var.engine_version
  instance_class = var.instance_class

  allocated_storage = var.allocated_storage
  storage_type      = "gp3"
  storage_encrypted = true

  db_name  = var.db_name
  # AWS makes this the master user at RDS instance creation
  username = var.admin_user
  password = random_password.admin.result
  port     = 5432

  # Private only: no public address, reachable from the app server's security group.
  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [var.db_sg_id]
  publicly_accessible    = false

  # Dev settings: single AZ, short backups, no final snapshot, easy teardown.
  multi_az                   = false
  backup_retention_period    = 1
  auto_minor_version_upgrade = true
  apply_immediately          = true
  deletion_protection        = false
  skip_final_snapshot        = true
  copy_tags_to_snapshot      = true

  tags = { Name = "${local.name}-db" }
}

############################ Schema scripts, run from EC2 ############################
# The database has no public path, so the scripts run on the app server (same VPC),
# uploaded from your machine over SSH. Each script runs once; see scripts/run_schema.sh.
resource "null_resource" "schema" {
  triggers = {
    db_instance  = aws_db_instance.postgres.id
    app_host     = var.app_host
    scripts_hash = local.scripts_hash
    runner_hash  = local.runner_hash
    entry_script = var.entry_script
    schema_mode  = var.schema_mode
    app_pw_hash  = nonsensitive(sha256(random_password.app.result))
  }

  connection {
    type        = "ssh"
    host        = var.app_host
    user        = var.ssh_user
    private_key = file(pathexpand(var.ssh_private_key_path))
    timeout     = "5m"
  }

  provisioner "remote-exec" {
    inline = [
      "set -e",
      "cloud-init status --wait",
      "rm -rf /tmp/dbscripts",
      "mkdir -p -m 700 /tmp/dbscripts/sql",
    ]
  }

  # Trailing slash: upload the folder(dbScripts) contents, subfolders (schema/, data/) included.

  provisioner "file" {
    source      = "${var.scripts_dir}/"
    destination = "/tmp/dbscripts/sql"
  }

  provisioner "file" {
    content     = file("${path.module}/scripts/bootstrap.sql")
    destination = "/tmp/dbscripts/bootstrap.sql"
  }

  provisioner "file" {
    content     = file("${path.module}/scripts/run_schema.sh")
    destination = "/tmp/dbscripts/run_schema.sh"
  }

  provisioner "file" {
    content     = local.db_env
    destination = "/tmp/dbscripts/db.env"
  }

  provisioner "remote-exec" {
    inline = [
      "set -e",
      "bash /tmp/dbscripts/run_schema.sh",
    ]
  }
}